# ============================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example)
#
# INSTRUCCIONES:
#  1. Copiá este archivo y renombrá la copia como:  .env
#  2. Completá los valores reales (los de tu base MySQL).
#  3. NUNCA subas el archivo .env a GitHub ni lo compartas:
#     contiene tu contraseña. Ya está protegido en .gitignore.
#
# En Hostinger NO se usa este archivo: los mismos valores se
# cargan como "variables de entorno" en el panel de la Web App
# (ver docs/GUIA_DEPLOY_HOSTINGER.md).
# ============================================================

# --- Base de datos MySQL ---
# En tu PC (desarrollo local): los valores de tu MySQL local si instalás uno,
# o podés trabajar directo contra pruebas en Hostinger más adelante.
# En Hostinger: host suele ser localhost y los datos son los que
# anotaste al crear la base en hPanel (con el prefijo u123456789_).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nombre_de_tu_base
DB_USER=usuario_de_tu_base
DB_PASSWORD=tu_contraseña_secreta

# --- Servidor ---
# Puerto local. En Hostinger se ignora (el hosting asigna el suyo).
PORT=3000

# Entorno: 'desarrollo' en tu PC, 'produccion' en Hostinger.
NODE_ENV=desarrollo

# --- Login ---
# Clave secreta para firmar los tokens de sesión (JWT). Generá una propia
# (cualquier texto largo y aleatorio sirve, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# Usá una clave DISTINTA en Hostinger a la de tu PC.
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

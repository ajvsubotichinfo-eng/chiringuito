# ============================================================
# Archivos que NUNCA se suben a GitHub
# ============================================================

# Credenciales y configuración local (¡contiene contraseñas!)
.env

# Dependencias instaladas (se regeneran con: npm install)
node_modules/

# Archivos temporales del sistema
.DS_Store
Thumbs.db

# Logs
*.log

# Fotos de comprobantes de pago subidas por los usuarios (contenido real
# de la tienda, no código — no se sube al repositorio).
public/uploads/comprobantes/*
!public/uploads/comprobantes/.gitkeep

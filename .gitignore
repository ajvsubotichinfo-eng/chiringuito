# ============================================================
# Archivos que NUNCA se suben a GitHub
# ============================================================

# Credenciales y configuración local (¡contiene contraseñas!)
.env

# Dependencias instaladas (se regeneran con: npm install)
node_modules/

# Archivos temporales del sistema
.DS_Store
Thumbs.db

# Logs
*.log

# Capturas y sesiones de prueba de playwright-cli (usado por Claude para
# probar la app en el navegador; no es parte del código del proyecto).
.playwright-cli/

# Configuración local de Claude Code (lanza el servidor de prueba en el
# navegador); no es parte del código del proyecto.
.claude/

# Fotos de comprobantes de pago subidas por los usuarios (contenido real
# de la tienda, no código — no se sube al repositorio). Vive FUERA de
# /public a propósito: ese build se pisa en cada deploy de React.
uploads/comprobantes/*
!uploads/comprobantes/.gitkeep
